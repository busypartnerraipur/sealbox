<?xml version="1.0" encoding="utf-8"?>
<!-- Sealbox build settings, imported by the user-mode projects. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>SEALBOX_NO_SIGNATURE_CHECK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
